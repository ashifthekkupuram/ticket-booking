{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/contracts": [
        "./libs/contracts/src/index.ts"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/inbox": [
        "./libs/inbox/src/index.ts"
      ],
      "@app/inbox/*": [
        "./libs/inbox/src/*"
      ],
      "@app/kafka": [
        "./libs/kafka/src/index.ts"
      ],
      "@app/kafka/*": [
        "./libs/kafka/src/*"
      ],
      "@app/outbox": [
        "./libs/outbox/src/index.ts"
      ],
      "@app/outbox/*": [
        "./libs/outbox/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/ticket-booking/tsconfig.app.json"
    },
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/identity/tsconfig.app.json"
    },
    {
      "path": "./apps/event/tsconfig.app.json"
    },
    {
      "path": "./apps/reservation/tsconfig.app.json"
    },
    {
      "path": "./apps/payment/tsconfig.app.json"
    },
    {
      "path": "./apps/ticket/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}